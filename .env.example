HOST_PORT=18080
DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=geo_system
DB_USER=geo_user
DB_PASSWORD=geo_password
DB_EXPOSE_PORT=15432
CRON_INTERVAL=60
SITE_NAME=Lynden Brothers GEO
SITE_FULL_NAME=Lynden Brothers GEO
SITE_DESCRIPTION=基于AI的智能内容生成与发布平台
SITE_KEYWORDS=GEO,AI内容生成,SEO,智能写作,内容发布
ADMIN_BASE_PATH=dl-console
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-this-before-delivery
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_WEBSITE=
APP_SECRET_KEY=replace-with-a-long-random-secret
SITE_URL=http://localhost:18080
TZ=Asia/Shanghai
REQUIRE_STRONG_APP_SECRET=false
REQUIRE_BOOTSTRAP_ADMIN=false

# GEO monitoring providers
DOUBAO_API_KEY=
KIMI_API_KEY=
QIANWEN_API_KEY=
YUANBAO_API_KEY=
DEEPSEEK_API_KEY=
GEO_MONITOR_NODE_BIN=node
GEO_MONITOR_NODE_PATH=
GEO_MONITOR_PHP_RUNNER=php
GEO_MONITOR_CRON_ENABLED=true

# Optional real web search context for citation/GEO monitor.
# Configure in the admin UI when possible; env value is kept as deployment reference.
BOCHA_API_KEY=

# Media distribution automation
DISTRIBUTION_NODE_BIN=node
DISTRIBUTION_NODE_PATH=
DISTRIBUTION_BROWSER_PROFILE_DIR=data/browser-profiles
DISTRIBUTION_LOGIN_WAIT_SECONDS=600
DISTRIBUTION_PHP_RUNNER=php
DISTRIBUTION_AUTO_PUBLISH_ENABLED=true
DISTRIBUTION_AUTO_START_ENABLED=true
DISTRIBUTION_BROWSER_HEADLESS=true
DISTRIBUTION_PUBLISH_MIN_INTERVAL_HOURS=4
DISTRIBUTION_CRON_START_LIMIT=3
# Optional per-platform override, for example:
# DISTRIBUTION_ZHIHU_MIN_INTERVAL_HOURS=4
